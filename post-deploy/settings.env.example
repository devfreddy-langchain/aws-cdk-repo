# =============================================================================
# post-deploy/settings.env — inputs for the post-deploy scripts that are NOT CDK outputs
#
#   cp post-deploy/settings.env.example post-deploy/settings.env && $EDITOR post-deploy/settings.env
#
# Everything about your AWS resources (names, ARNs, endpoints, region, workload identity
# mode) comes from out/cdk-outputs.json, which `cdk deploy --outputs-file` writes. This file
# only holds FILE PATHS and pinned versions — never a secret value. Paths are relative to
# the repository root. Keep the files they point to in ./secrets/ (git-ignored) or outside
# the repository. Every line is optional.
# =============================================================================

# ----------------------------------------------------------- secrets ----
# The license key from LangChain, a text file with the key only. Used by 01-seed-secrets.sh
# while <name>/license-key still holds the placeholder REPLACE_ME. Delete the file afterwards.
LICENSE_KEY_FILE=./secrets/langsmith-license.txt

# ---------------------------------------------------------------- TLS ----
# PEM files that 00-import-certificate.sh imports into ACM (before cdk deploy; skip them when you
# already have an ISSUED ACM certificate). The private key goes to ACM only (never to the cluster).
TLS_CERT_FILE=./secrets/tls/server.crt
TLS_KEY_FILE=./secrets/tls/server.key
TLS_CHAIN_FILE=./secrets/tls/ca.crt

# Only if LangSmith pods must trust a private CA (your certificate's issuer, a TLS-inspecting
# proxy): a PEM bundle that contains the PUBLIC roots AND your CA. The chart replaces the
# pods' trust store with this file, so a bundle with only your CA breaks calls to public sites.
CUSTOM_CA_BUNDLE_FILE=

# ------------------------------------------------------------ Helm ----
# Optional extra Helm values layered on top of out/langsmith-values.yaml (replica counts,
# resources, SSO, ...). Added last to out/helm-install-langsmith.sh by 04.
EXTRA_VALUES_FILE=

# ---------------------------------------------- pinned versions ----
# The versions are pinned in post-deploy/lib.sh, the one place to change them. Uncomment a line
# only to override it for this checkout (the values shown are the defaults).
# 03-mirror-images.sh mirrors exactly these versions; 04 installs exactly these versions.
# Change a version -> re-run 03, then 04.
# LANGSMITH_CHART_VERSION=0.17.0
# LBC_CHART_VERSION=3.5.0
# ESO_CHART_VERSION=2.11.0
# CLUSTER_AUTOSCALER_CHART_VERSION=9.56.0
# CLUSTER_AUTOSCALER_IMAGE_TAG=v1.34.5     # keep the minor version equal to your EKS version
# KEDA_CHART_VERSION=2.20.1
# Envoy Gateway (ingress mode envoy-gateway): the chart, and the Envoy proxy image that release is
# tested with (the chart's default). Keep the two in step; v1.9 is supported until 2027-02-14.
# ENVOY_GATEWAY_CHART_VERSION=v1.9.2
# ENVOY_PROXY_IMAGE_TAG=distroless-v1.39.1
# Helper images (mirrored by 03): the database bootstrap Job (04), the smoke tests (05), and the
# Postgres and Redis the Deployments operator runs next to each agent. Exact tags only.
# BOOTSTRAP_PG_IMAGE=docker.io/library/postgres:18.6
# SMOKE_CURL_IMAGE=docker.io/curlimages/curl:8.12.1
# OPERATOR_REDIS_IMAGE=docker.io/library/redis:7.4.11
# OPERATOR_PGVECTOR_IMAGE=docker.io/pgvector/pgvector:0.8.7-pg15
